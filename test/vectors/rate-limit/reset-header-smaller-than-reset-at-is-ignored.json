{
  "name": "reset-header-smaller-than-reset-at-is-ignored",
  "input": {
    "upstreamHeaders": {
      "anthropic-ratelimit-unified-reset": "1000000010"
    },
    "now": 1000000000000,
    "timeZone": "UTC",
    "resetAt": 1000000200000
  },
  "expected": {
    "status": 429,
    "headers": {
      "anthropic-ratelimit-unified-reset": "1000000010",
      "content-type": "application/json",
      "retry-after": "200",
      "anthropic-ratelimit-unified-status": "rejected"
    },
    "body": "{\"type\":\"error\",\"error\":{\"type\":\"rate_limit_error\",\"message\":\"You've hit your usage limit · resets at 1:50 AM UTC\"}}"
  }
}
