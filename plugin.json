{
  "$schema": "https://weivel.github.io/model/plugin.schema.json",
  "id": "claude-code-proxy",
  "api": 1,
  "version": "3.0.0",
  "entry": "dist/plugin.js",
  "bundle": {
    "entry": "src/plugin.ts"
  },
  "displayName": "Claude Code proxy",
  "capabilities": [
    "front-door"
  ],
  "config": {
    "defaults": {
      "upstream": "https://api.anthropic.com"
    }
  },
  "publish": {
    "scopedOnly": true
  },
  "repo": {
    "role": "Anthropic and Claude Code proxy layer",
    "category": "app-proxy",
    "domains": [
      "claude",
      "anthropic"
    ],
    "tech": [
      "typescript"
    ]
  }
}
