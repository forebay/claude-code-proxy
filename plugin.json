{
  "api": 1,
  "importName": "claude-code-proxy",
  "id": "claude-code-proxy",
  "version": "3.0.0",
  "entry": "dist/plugin.js",
  "bundle": {
    "entry": "src/plugin.ts"
  },
  "displayName": "Claude Code proxy",
  "capabilities": {
    "provides": [],
    "consumes": ["forebay.provider"]
  },
  "services": {
    "consumes": ["routing", "anthropic", "weivel.config", "weivel.log"]
  },
  "config": {
    "defaults": {
      "upstream": "https://api.anthropic.com",
      "proxy": {
        "port": 34567,
        "placeholderAuthorization": "Bearer sk-ant-loader-proxy"
      },
      "routing": {
        "tierSourceProvider": "claude-code-provider",
        "tierOrder": ["opus", "sonnet", "haiku", "fable"],
        "tierFallback": ["opus", "sonnet", "haiku"],
        "tierRegex": "^claude-([a-z]+)-\\d",
        "nativeModelPattern": "^claude-",
        "defaultContext": 200000,
        "defaultOutput": 64000,
        "loginCommand": "forebay-host action claude-code"
      }
    }
  },
  "access": [
    { "kind": "port", "target": "setting:proxy.port", "mode": "listen", "why": "Claude Code sends its requests to the proxy here" },
    { "kind": "network", "target": "setting:upstream", "mode": "connect", "why": "a request no provider serves passes through to the upstream" }
  ],
  "publish": {
    "scopedOnly": true
  },
  "repo": {
    "role": "Anthropic and Claude Code proxy layer",
    "category": "app-proxy",
    "domains": ["claude", "anthropic"],
    "tech": ["typescript"]
  }
}
